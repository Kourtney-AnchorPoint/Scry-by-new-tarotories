{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The user's written reflection"
    },
    "mood": {
      "type": "string",
      "enum": [
        "grateful",
        "hopeful",
        "reflective",
        "heavy",
        "unsettled",
        "peaceful",
        "confused",
        "energized"
      ],
      "description": "How the user is feeling"
    },
    "title": {
      "type": "string",
      "description": "Optional short title for the entry"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}